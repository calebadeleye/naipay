###############################################################################
# Every Merchant API — environment template
#
# Copy to .env and fill in. Never commit a populated .env.
# Every variable is documented in docs/environment-variables.md.
###############################################################################

# --- Application -------------------------------------------------------------
APP_NAME="Every Merchant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.1.0
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Where the administrative frontend is served from. Used for password reset
# links, login alerts and CORS.
ADMIN_APP_URL=http://localhost:3000

# Where the standalone merchant self-service portal is served from. Used for
# account activation and password reset links.
MERCHANT_APP_URL=http://localhost:3001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Database ----------------------------------------------------------------
# MySQL 8 with InnoDB and utf8mb4. Financial operations rely on transactional
# storage and SELECT ... FOR UPDATE row locking.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naipay
DB_USERNAME=root
DB_PASSWORD=

# Separate database used by the test suite. It is migrated fresh on each run.
DB_TEST_DATABASE=naipay_testing

# --- Redis -------------------------------------------------------------------
# Backs the cache, queue and rate limiter. `predis` needs no PHP extension;
# switch to `phpredis` in production where the extension is available.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# --- Cache, queue and session ------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=naipay

QUEUE_CONNECTION=redis
# Queue names, highest priority first. Financial postings must never sit behind
# a bulk export.
QUEUE_HIGH=naipay-high
QUEUE_DEFAULT=naipay-default
QUEUE_LOW=naipay-reports

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# --- Authentication ----------------------------------------------------------
# Bearer token lifetime in minutes for administrative API tokens.
NAIPAY_TOKEN_LIFETIME_MINUTES=480
NAIPAY_SESSION_IDLE_MINUTES=30
NAIPAY_MAX_LOGIN_ATTEMPTS=5
NAIPAY_LOCKOUT_MINUTES=30

SANCTUM_STATEFUL_DOMAINS=localhost:3000

# --- Logging -----------------------------------------------------------------
# `stack` writes both a human-readable daily log and a structured JSON stream
# for aggregation. Sensitive keys are scrubbed before anything is written.
LOG_CHANNEL=stack
LOG_STACK=daily,structured
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null

# --- File storage ------------------------------------------------------------
# `local` during development, `s3` in production. MinIO is supported by
# pointing AWS_ENDPOINT at the MinIO host and enabling path-style access.
FILESYSTEM_DISK=local
NAIPAY_DOCUMENT_DISK=documents
NAIPAY_MAX_UPLOAD_KB=10240

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="naipay@naitalk.com"
MAIL_FROM_NAME="Every Merchant"

# --- SMS (optional in the first release) -------------------------------------
NAIPAY_SMS_ENABLED=false
NAIPAY_SMS_PROVIDER=log
NAIPAY_SMS_API_KEY=
NAIPAY_SMS_SENDER_ID=EveryMerchant

# --- Branding ----------------------------------------------------------------
NAIPAY_LEGAL_NAME="Every Merchant Microfinance"
NAIPAY_SUPPORT_EMAIL=support@naitalk.com
NAIPAY_SUPPORT_PHONE=
NAIPAY_WEBSITE=https://everymerchant.naitalk.com

# --- Domain policy -----------------------------------------------------------
# Defaults are defined in config/naipay.php; override here only where an
# environment genuinely differs.
NAIPAY_CURRENCY=NGN
NAIPAY_DISPLAY_TIMEZONE=Africa/Lagos
NAIPAY_ALLOW_OVERPAYMENT=true
NAIPAY_DUPLICATE_LOOKBACK_DAYS=30
NAIPAY_ENFORCE_PERIOD_LOCK=true
NAIPAY_PAR_THRESHOLD_DAYS=30
NAIPAY_EXPORT_QUEUE_THRESHOLD=5000
