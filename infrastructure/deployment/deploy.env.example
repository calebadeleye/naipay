# Copy to deploy.env on each target host and fill in.
# deploy.env is gitignored — it is per-host and must never be committed.

# ======================================================================
# everymerchant-deploy  (naitalk2loan / web67)  → run: deploy.sh all
#   repo root: ~/private/naipay  (npm workspaces monorepo)
# ======================================================================
# EM_API_DIR=~/private/naipay/backend/api
# EM_ADMIN_DIR=~/private/naipay/apps/admin-web
# EM_ADMIN_PM2=every-merchant-web

# ======================================================================
# everymerchant-portal-deploy  (naitalk2portal / web68)  → run: deploy.sh all
#   repo root: ~/private/naipay-merchant-web
# ======================================================================
# EM_PORTAL_DIR=~/private/naipay-merchant-web/apps/merchant-web
# EM_PORTAL_PM2=every-merchant-portal

# --- common ------------------------------------------------------------------
EM_BRANCH=main
EM_GIT_PULL=1     # both checkouts are non-git today; leave 1, it warns and continues
EM_NPM_INSTALL=1  # set 0 to skip `npm ci` when no dependency changed
EM_COMPOSER=1     # set 0 to skip `composer install`
EM_MIGRATE=1      # set 0 to skip migrations
