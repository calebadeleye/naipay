# Copy to deploy.env on each target host and fill in.
# deploy.env is gitignored — it is per-host and must never be committed.
#
#   everymerchant-deploy  (naitalk2loan)   sets EM_API_DIR + EM_ADMIN_DIR
#   everymerchant-portal-deploy (naitalk2portal) sets EM_PORTAL_DIR

# --- everymerchant-deploy -------------------------------------------------
# EM_API_DIR=/var/www/clients/clientX/webY/web/backend
# EM_ADMIN_DIR=/var/www/clients/clientX/webY/web/frontend
# EM_ADMIN_PM2=every-merchant-admin

# --- everymerchant-portal-deploy ---------------------------------------------
# EM_PORTAL_DIR=/var/www/clients/clientX/webZ/web
# EM_PORTAL_PM2=every-merchant-portal

# --- common ------------------------------------------------------------------
EM_BRANCH=main
EM_GIT_PULL=1
